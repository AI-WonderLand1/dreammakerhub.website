# UpCloud Deployment Environment Variables
# Copy this file to .env and fill in real values
# Server: dreammakerhub-01, IP: 152.44.43.125, Zone: us-chi1

# === UpCloud ===
UPCLOUD_API_KEY=your-upcloud-api-key
UPCLOUD_SERVER_IP=152.44.43.125
UPCLOUD_SERVER_HOST=152-44-43-125.us-chi1.upcloud.host

# === Coder IDE ===
CODER_DB_PASSWORD=change-me-to-a-strong-password
CODER_SESSION_TOKEN=change-me-to-a-coder-session-token

# === Supabase (backend) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-ref:your-password@db.your-ref.supabase.co:5432/postgres

# === App ===
NEXT_PUBLIC_URL=https://dreammakerhub.website
NEXT_PUBLIC_CODER_ACCESS_URL=https://coder.dreammakerhub.website
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=https://dreammakerhub.website

# === AI Providers ===
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Stripe (optional) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_PRO_YEARLY_ID=
STRIPE_PRICE_TEAM_ID=
STRIPE_PRICE_TEAM_YEARLY_ID=

# === Certbot / TLS ===
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
LETSENCRYPT_EMAIL=your@email.com

# === Domain ===
DOMAIN=dreammakerhub.website
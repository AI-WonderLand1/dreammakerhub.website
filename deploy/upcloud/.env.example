# UpCloud Deployment Environment Variables
#
# DO NOT put production secrets in this file or copy real values into git.
# Production application secrets are sourced from GitHub Actions secrets/vars
# by .github/workflows/deploy-upcloud.yml and written to the server .env with
# mode 600 during deployment.
#
# This file is only a reference for the names the deployment/runtime expects.

# === UpCloud ===
UPCLOUD_API_KEY=your-upcloud-api-key
UPCLOUD_SERVER_IP=152.44.43.125
UPCLOUD_SERVER_HOST=152-44-43-125.us-chi1.upcloud.host

# === Coder IDE ===
CODER_DB_PASSWORD=change-me-to-a-strong-password
CODER_SESSION_TOKEN=change-me-to-a-coder-session-token
CODER_API_URL=https://coder.dreammakerhub.website
CODER_ACCESS_URL=https://coder.dreammakerhub.website
CODER_API_TOKEN=change-me-to-a-coder-api-token
CODER_WORKSPACE_OWNER=me

# === Supabase (backend) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-ref:your-password@db.your-ref.supabase.co:5432/postgres

# === App ===
NEXT_PUBLIC_URL=https://dreammakerhub.website
NEXT_PUBLIC_CODER_ACCESS_URL=https://coder.dreammakerhub.website
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=https://dreammakerhub.website

# === AI Providers ===
# Required for builder AI editing.
OPENROUTER_API_KEY=your-openrouter-api-key
# Required for WonderBuild AI template generation. The deploy workflow also
# accepts GOOGLE_AI_API_KEY as a compatibility source and maps it to GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
ALICE_API_KEY=

# === Automation / integrations ===
N8N_API_KEY=
N8N_WEBHOOK_URL=

# === Encryption ===
EXTENSION_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY=

# === Stripe (optional) ===
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_PRO_YEARLY_ID=
STRIPE_PRICE_TEAM_ID=
STRIPE_PRICE_TEAM_YEARLY_ID=

# === Other optional runtime config ===
NEXT_PUBLIC_WEBCONTAINER_CLIENT_ID=
ADMIN_USER_IDS=
AGENT_API_URL=
SPLAT_TRAINING_WEBHOOK=
SPLAT_CALLBACK_SECRET=

# === Certbot / TLS ===
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
LETSENCRYPT_EMAIL=your@email.com

# === Domain ===
DOMAIN=dreammakerhub.website

# --- WonderSpace IDE - Coder in a Box Configuration ---
# Override these values with -e flags when running docker run

# The URL users will type to reach their IDE
# Example: docker run -e CODER_ACCESS_URL=https://ide.yourdomain.com ...
CODER_ACCESS_URL=http://localhost:7080

# The wildcard for individual user workspace previews (critical for web dev!)
# Example: *.ide.yourdomain.com
CODER_WILDCARD_ACCESS_URL="*.ide.localhost"

# The port Coder listens on
CODER_HTTP_ADDRESS=0.0.0.0:7080

# --- DATABASE ---
# Automatically configured by entrypoint.sh (uses internal PostgreSQL)
# Override only if you want to use an external database:
CODER_PG_CONNECTION_URL=postgres://coder@localhost:5432/coder?sslmode=disable

# --- GITHUB AUTH (optional) ---
# Uncomment to enable GitHub SSO:
# CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS=true
# CODER_OAUTH2_GITHUB_CLIENT_ID=your-client-id
# CODER_OAUTH2_GITHUB_CLIENT_SECRET=your-client-secret

# --- WORKSPACE IMAGE ---
# The Docker image used for user IDE workspaces
# Defaults to the bundled wonderspace-ide-workspace image
# Falls back to codercom/enterprise-base:ubuntu if bundled image fails to load
WORKSPACE_IMAGE=wonderspace-ide-workspace:latest
FALLBACK_IMAGE=codercom/enterprise-base:ubuntu

# --- TELEMETRY & UPDATES ---
CODER_TELEMETRY_ENABLE=false
CODER_UPDATE_CHECK=false
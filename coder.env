# --- CONFIGURATION TEMPLATE ---
# These values are injected via Vault annotations in the K8s deployment
# DO NOT hardcode secrets here - use external-secrets or Vault integration

# The URL people will type to reach your IDE
CODER_ACCESS_URL="https://dreammakerhub.website"

# The wildcard for individual user previews (Critical for web dev!)
CODER_WILDCARD_ACCESS_URL="*.ide.dreammakerhub.website"

# The port Coder listens on
CODER_HTTP_ADDRESS="0.0.0.0:7080"

# --- GITHUB AUTH ---
# These should be injected from Vault at runtime:
# CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS=true
# CODER_OAUTH2_GITHUB_CLIENT_ID
# CODER_OAUTH2_GITHUB_CLIENT_SECRET

# --- DATABASE ---
# Point to internal service for DB connection
# CODER_PG_CONNECTION_URL is injected from Vault secret "coder-db-url"

# --- TELEMETRY & UPDATES ---
CODER_TELEMETRY_ENABLE=false
CODER_UPDATE_CHECK=false
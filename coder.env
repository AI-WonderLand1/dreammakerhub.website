# --- BASIC SETUP ---
# The URL people will type to reach your IDE
CODER_ACCESS_URL="http://127.0.0.1:3000"

# The wildcard for individual user previews (Critical for web dev!)
CODER_WILDCARD_ACCESS_URL="*.ide.yourdomain.com"

# The port Coder listens on
CODER_HTTP_ADDRESS="0.0.0.0:3000"

# --- GITHUB AUTH (For your "Everyone" link) ---
# This lets users sign up using their GitHub account
CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS=true
CODER_OAUTH2_GITHUB_CLIENT_ID="your_github_client_id"
CODER_OAUTH2_GITHUB_CLIENT_SECRET="your_github_client_secret"

# --- DATABASE ---
# If you aren't using the built-in one, point to your Supabase or local Postgres
# CODER_PG_CONNECTION_URL="postgres://user:pass@localhost:5432/coder?sslmode=disable"

# --- TELEMETRY & UPDATES ---
CODER_TELEMETRY_ENABLE=false
CODER_UPDATE_CHECK=true

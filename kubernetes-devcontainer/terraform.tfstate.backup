            "shutdown_script": null,
            "startup_script": "#!/bin/bash\nset -e\n\n# Clone repo if set and directory is empty\nREPO=\"https://github.com/wonderingtribe/psychic-octo-fishstick\"\nif [ -n \"$REPO\" ] \u0026\u0026 [ ! -d /home/coder/project/.git ]; then\n  git clone \"$REPO\" /home/coder/project 2\u003e/dev/null || true\nfi\n\n# Ensure project directory exists\nmkdir -p /home/coder/project\n\n# Set up git config\ngit config --global user.name \"default\"\ngit config --global user.email \"default@example.com\"\ngit config --global init.defaultBranch main\n\necho \"Workspace ready for default!\"\n",

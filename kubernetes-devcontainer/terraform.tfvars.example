# Coder Workspace Configuration for OKE

# Coder Server Configuration
coder_url = "https://coder.yourdomain.com"  # Your Coder server URL

# Kubernetes Configuration (for Coder server running in OKE)
use_kubeconfig = false  # Set to true for local development

# For in-cluster authentication (when Coder runs in OKE):
# These are automatically set by Kubernetes when Coder runs as a pod
# k8s_host = "https://kubernetes.default.svc"
# k8s_token = file("/var/run/secrets/kubernetes.io/serviceaccount/token")
# k8s_ca_cert = file("/var/run/secrets/kubernetes.io/serviceaccount/ca.crt")

# OCI Registry Configuration
oci_registry = "iad.ocir.io/your-tenancy/wonderspace"
cache_repo   = "iad.ocir.io/your-tenancy/wonderspace/cache"

# Optional: Use insecure registry (for testing only)
# insecure_cache_repo = false

# Kubernetes namespace for workspaces
namespace = "wonderland-workspaces"

# OCIR Authentication
# Create this secret in your K8s cluster:
# kubectl create secret docker-registry ocir-cred \
#   --namespace=wonderland-workspaces \
#   --docker-server=iad.ocir.io \
#   --docker-username='your-tenancy/your-username' \
#   --docker-password='your-auth-token' \
#   --docker-email='your-email@example.com'
cache_repo_dockerconfig_secret = "ocir-cred"

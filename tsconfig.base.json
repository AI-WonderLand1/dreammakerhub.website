{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": [
        "engine/*"
      ],
      "@ui/*": [
        "ui/*"
      ],
      "@infra/*": [
        "infra/*"
      ],
      "@lib/*": [
        "apps/web/lib/*"
      ],
      "@types/*": [
        "types/*"
      ],
      "@runners/*": [
        "runners/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@core/*": [
        "engine/core/*"
      ],
      "@components/*": [
        "ui/components/*"
      ],
      "@puckeditor/core": [
        "packages/puckeditor-core/index.js"
      ],
      "@puckeditor/core/*": [
        "packages/puckeditor-core/*"
      ],
      "@/lib/*": [
        "apps/web/lib/*"
      ],
      "@/types/*": [
        "apps/web/types/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "public",
    "apps/web/public"
  ]
}

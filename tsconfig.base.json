{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
        "@wonderspace/ide-engine": ["packages/ide-engine/src"],
      "@engine/*": [
        "engine/*"
      ],
      "@ui/*": [
        "ui/*"
      ],
      "@infra/*": [
        "infra/*"
      ],
      "@lib/*": [
        "apps/web/lib/*"
      ],
      "@types/*": [
        "types/*"
      ],
      "@runners/*": [
        "runners/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@core/*": [
        "engine/core/*"
      ],
      "@components/*": [
        "ui/components/*"
      ],
      "@/lib/*": [
        "apps/web/lib/*"
      ],
      "@/types/*": [
        "apps/web/types/*"
      ],
      "@/components/*": [
        "apps/web/components/*"
      ],
      "@/app/*": [
        "apps/web/app/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "public",
    "apps/web/public"
  ]
}

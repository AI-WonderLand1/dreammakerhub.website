{
  "name": "@wonderspace/ide-engine",
  "version": "1.0.0",
  "private": true,
  "description": "WebContainer-based browser IDE engine",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"

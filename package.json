{
  "name": "ai-wonderland",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "npc-sim"
  ],
  "overrides": {
    "tar": ">=7.5.11",
    "@tootallnate/once": ">=2.0.1",
    "hono": ">=4.6.0",
    "uuid": ">=14.0.0",
    "@hono/node-server": ">=1.19.13",
    "fast-xml-parser": ">=5.7.0",
    "postcss": ">=8.5.3",
    "brace-expansion": ">=2.0.1",
    "@prisma/dev": {
      "@hono/node-server": ">=1.19.13"
    },
    "@mediapipe/tasks-vision": ">=0.10.35"
  },
  "scripts": {
    "dev": "npm run dev --workspace=ai-wonder-web",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "swarm:unreal": "node scripts/swarm/run-unreal-stack.mjs",
    "registry:sync": "node scripts/registry/sync-assets.mjs",
    "registry:sync:dry": "node scripts/registry/sync-assets.mjs --dry-run",
    "lint": "eslint apps/ engine/ packages/ runners/ infra/ --fix",
    "clean:ghosts": "npx ts-prune -p tsconfig.json && npm run lint",
    "postinstall": "prisma generate"
  },
"devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "8.20.0",
    "eslint": "^10.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lodash-es": "^4.18.1",
    "prisma": "^7.8.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.0",
    "undici": "^8.5.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.5.3",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "mem0ai": "^3.0.9",
    "pg": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.6"
  },
  "type": "module"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_generation_logs {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prompt_id             String?                @db.Uuid
  input_text            String?
  output_response       String?
  success               Boolean?
  latency_ms            Int?
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  ai_playground_prompts ai_playground_prompts? @relation(fields: [prompt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_playground_prompts {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?              @db.Uuid
  label               String
  system_prompt       String?
  user_input_template String?
  temperature         Float?               @default(0.7)
  created_at          DateTime?            @default(now()) @db.Timestamptz(6)
  ai_generation_logs  ai_generation_logs[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_prompts {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  system_instruction String?
  model_version      String?   @default("gpt-4o")
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_settings {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  default_model String?  @default("gemini-1.5-pro")
  system_prompt String?
  is_active     Boolean? @default(true)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model asset_metadata {
  asset_id     String   @id @db.Uuid
  poly_count   Int?
  has_uvs      Boolean? @default(true)
  is_rigged    Boolean? @default(false)
  format       String?
  dimensions_x Float?
  dimensions_y Float?
  dimensions_z Float?
  assets       assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assets {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String?                @db.Uuid
  user_id            String                 @db.Uuid
  name               String
  type               String?
  file_path          String
  metadata           Json?                  @default("{}")
  created_at         DateTime?              @default(now()) @db.Timestamptz(6)
  folder_id          String?                @db.Uuid
  embedding          Unsupported("vector")?
  description_vector Unsupported("vector")?
  asset_metadata     asset_metadata?
  folders            folders?               @relation(fields: [folder_id], references: [id], onUpdate: NoAction)
  projects           projects?              @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model confessions {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String
  title      String
  detail     String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model embeddings {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content    String?
  metadata   Json?
  embedding  Unsupported("vector")?
  created_at DateTime?              @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model folders {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String?   @db.Uuid
  parent_id     String?   @db.Uuid
  name          String
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  assets        assets[]
  folders       folders?  @relation("foldersTofolders", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_folders folders[] @relation("foldersTofolders")
  projects      projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ide_settings {
  user_id       String    @id @db.Uuid
  settings_json Json?     @default("{}")
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model memories {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?                @db.Uuid
  content    String
  metadata   Json?
  embedding  Unsupported("vector")?
  created_at DateTime?              @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model oauth_apps {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  owner_id      String    @db.Uuid
  name          String
  description   String?
  logo_url      String?
  client_id     String    @unique
  redirect_uris String[]
  website_url   String?

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pages {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  title           String    @default("Untitled Page")
  slug            String    @unique
  body_html       String    @default("")
  cover_image_url String?
  content         Json
  published       Boolean   @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([slug])
  @@index([user_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id         String    @id @db.Uuid
  username   String?   @unique
  full_name  String?
  avatar_url String?
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  website    String?

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model project_history {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String?   @db.Uuid
  snapshot   Json
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  created_by String?   @db.Uuid
  projects   projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model project_members {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String?       @db.Uuid
  user_id    String        @db.Uuid
  role       project_role? @default(viewer)
  joined_at  DateTime?     @default(now()) @db.Timestamptz(6)
  projects   projects?     @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, user_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model projects {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @db.Uuid
  name            String            @default("Untitled Project")
  scene_data      Json?             @default("{}")
  thumbnail_url   String?
  is_public       Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  assets          assets[]
  folders         folders[]
  project_history project_history[]
  project_members project_members[]
  puck_layouts    puck_layouts[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model puck_layouts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String?   @db.Uuid
  puck_data         Json
  last_published_at DateTime? @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  projects          projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model scenes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  name        String
  description String?
  data        Json      @default("{}")
  thumbnail   String?
  is_public   Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([updated_at(sort: Desc)], map: "idx_scenes_updated_at")
  @@index([user_id], map: "idx_scenes_user_id")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model secrets {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  name         String
  secret_value String
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @db.Uuid
  stripe_customer_id     String?   @unique
  stripe_subscription_id String?   @unique
  status                 String?
  price_id               String?
  quantity               Int?
  cancel_at_period_end   Boolean?
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  updated_at             DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model temp_uploads {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket       String   @default("temp")
  object_name  String
  owner        String   @db.Uuid
  content_type String?
  size         BigInt?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @default(dbgenerated("(now() + '24:00:00'::interval)")) @db.Timestamptz(6)
  uploaded     Boolean  @default(false)

  @@index([expires_at], map: "idx_temp_uploads_expires_at")
  @@index([owner], map: "idx_temp_uploads_owner")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usage_quotas {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  ai_tokens_used     BigInt?   @default(0)
  api_requests_count Int?      @default(0)
  monthly_limit      Int?      @default(1000)
  last_reset_date    DateTime? @default(now()) @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_api_tokens {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  provider      String
  encrypted_key String
  key_hint      String?
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([user_id, provider])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_assets {
  id            Int       @id @default(autoincrement())
  user_id       String?   @db.Uuid
  asset_id      String
  name          String?
  source        String?
  local_url     String?
  downloaded_at DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_projects {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?   @db.Uuid
  project_name        String    @default("New Universe")
  template_id         String
  enable_npc          Boolean?  @default(false)
  active_agents       String[]  @default([])
  ssh_key_fingerprint String?
  container_status    String?   @default("stopped")
  selected_assets     Json?     @default("[]")
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

enum project_role {
  owner
  editor
  viewer

  @@schema("public")
}
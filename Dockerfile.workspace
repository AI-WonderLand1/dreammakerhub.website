FROM codercom/code-server:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    wget \
    unzip \
    python3 \
    python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm typescript @playcanvas/cli

RUN mkdir -p /home/coder/.local/share/code-server/User \
    && mkdir -p /home/coder/project \
    && mkdir -p /home/coder/.config/code-server

COPY --chown=coder:coder config.yaml /home/coder/.config/code-server/config.yaml

RUN code-server --install-extension ms-playwright.playwright \
    && code-server --install-extension dbaeumer.vscode-eslint \
    && code-server --install-extension bradlc.vscode-tailwindcss \
    && code-server --install-extension ώξformulahendry.auto-rename-tag \
    && code-server --install-extension esbenp.prettier-vscode \
    || true

RUN mkdir -p /home/coder/project/.webglstudio \
    && mkdir -p /home/coder/project/.playcanvas

COPY --chown=coder:coder workspace-entrypoint.sh /usr/local/bin/workspace-entrypoint.sh
RUN chmod +x /usr/local/bin/workspace-entrypoint.sh

RUN chown -R coder:coder /home/coder

USER coder

ENV PORT=8080
ENV WS_DIR=/home/coder/project

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/workspace-entrypoint.sh"]
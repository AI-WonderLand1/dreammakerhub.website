{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "primary", "color": "#7c3aed", "name": "Primary Violet" },
        { "slug": "secondary", "color": "#06b6d4", "name": "Secondary Cyan" },
        { "slug": "dark", "color": "#0f172a", "name": "Dark Slate" },
        { "slug": "light", "color": "#f8fafc", "name": "Light Background" }
      ]
    },
    "typography": {
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.5rem", "name": "Large" },
        { "slug": "x-large", "size": "2.25rem", "name": "Extra Large" }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--dark)",
      "text": "var(--wp--preset--color--light)"
    }
  }
}

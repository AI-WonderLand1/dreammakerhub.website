{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
"paths": {
      "@/*": ["./"],
      "@app/*": ["./app/*"],
      "@builder/*": ["./app/(builder)/wonder-build/*"],
      "@core/*": ["../../engine/core/*"],
      "@components/*": ["../../ui/components/*"],
      "@lib/*": ["./lib/*"],
      "@lib": ["./lib"],
      "@engine/*": ["../../engine/*"],
      "@ui/*": ["../../ui/*"],
      "@infra/*": ["../../infra/*"],
      "@runners/*": ["../../runners/*"],
      "@services/*": ["../../infra/services/*"],
      "@types/*": ["../../types/*"],
      "@ai-modules/*": ["./ai-modules/*"],
      "@styles/*": ["./styles/*"],
      "@/utils/*": ["./app/utils/*", "./utils/*"],
      "@/components/*": ["./components/*"],
      "@/core/*": ["../../engine/core/*"],
      "@/infra/*": ["../../infra/*"],
      "@/runners/*": ["../../runners/*"],
      "@/types/*": ["../../types/*"],
      "@/ai-modules/*": ["./ai-modules/*"],
      "@/styles/*": ["./styles/*"],
      "@/data/*": ["./data/*"]
    },
    "skipLibCheck": true,
    "incremental": true,
    "types": ["next"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "plugins": [
      { "name": "next" }
    ],
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "../../engine/core/**/*.ts",
    "../../engine/core/**/*.tsx",
    "../../ui/components/**/*.ts",
    "../../ui/components/**/*.tsx",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
    "../../engine/**/*.ts",
    "../../ui/**/*.ts",
    "../../runners/**/*.ts",
    "../../infra/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "public"
  ]
}

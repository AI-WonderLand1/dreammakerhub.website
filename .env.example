# Coder (for IDE workspace provisioning)
CODER_API_TOKEN=your-coder-api-token-here
CODER_API_URL=http://212.2.240.19.nip.io

# Required
OPENCODE_API_KEY=op-xxx          # Your AI access key (secret)

# For local dev
CODER_ACCESS_URL=http://localhost:7080
ENABLE_TLS=false

# For production
DOMAIN=ide.yourcompany.com
ENABLE_TLS=true
CODER_WILDCARD_ACCESS_URL=*.ide.yourcompany.com

# Customer Coder rollout. Keep the operator switches off until the live
# template, OIDC identity path and compute controller checks pass.
CODER_IDE_TEMPLATE_NAME=ai-wonderland-google
CODER_OPERATOR_USER_ID=
CODER_WORKSPACE_CREATION_ENABLED=false
CODER_CUSTOMER_PROVISIONING_ENABLED=false
CODER_CUSTOMER_CONTROLLER_ENABLED=false

# Supabase (required for auth and database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres (project files + revisions) - use your Supabase Postgres connection string.
# Prefer the transaction pooler (port 6543) for serverless/Next.js:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# TLS is enabled automatically for remote hosts.
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Application URLs
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_WEBCONTAINER_CLIENT_ID=your-webcontainer-client-id

# Oracle (optional - for OCI Vault)
OCI_VAULT_OCID=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# AI Providers
# Keep provider credentials server-side. Do not create NEXT_PUBLIC_* AI secret keys.
# OpenRouter powers the main builder AI path; Gemini/Google AI powers WonderBuild generation.
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_API_KEY=
GEMINI_API_KEY=
ALICE_API_KEY=
N8N_API_KEY=
N8N_WEBHOOK_URL=https://aiwonderland.app.n8n.cloud/webhook/user-choice
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# AI memory (server-only)
# Mem0 provides semantic recall. MongoDB is an optional durable conversation archive.
MEM0AI_API_KEY=
MEM0_API_KEY=
MONGODB_URI=
MONGODB_DB=dreammakerhub
MONGODB_AI_MEMORY_ENABLED=false

# Agent API
AGENT_API_URL=http://localhost:8000

# Amplitude Analytics: configure these in your local .env and deployment settings.
# NEXT_PUBLIC_AMPLITUDE_API_KEY is a public browser ingestion key, not an admin secret.
# Never commit actual project keys to .env.example.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
AMPLITUDE_AI_API_KEY=

# Encryption
EXTENSION_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY=

# Stripe (optional - for billing)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CATALOG_PRODUCT_CREATOR_ID=
STRIPE_PRICE_CREATOR_ID=
STRIPE_PRICE_CREATOR_YEARLY_ID=
# Canonical Architect names; legacy PRO variables remain supported as fallbacks.
STRIPE_CATALOG_PRODUCT_ARCHITECT_ID=
STRIPE_PRICE_ARCHITECT_ID=
STRIPE_PRICE_ARCHITECT_YEARLY_ID=
STRIPE_CATALOG_PRODUCT_PRO_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_PRO_YEARLY_ID=
STRIPE_CATALOG_PRODUCT_STUDIO_ID=
STRIPE_PRICE_STUDIO_ID=
STRIPE_PRICE_STUDIO_YEARLY_ID=
STRIPE_CATALOG_PRODUCT_GUILD_ID=
STRIPE_PRICE_GUILD_ID=
STRIPE_PRICE_GUILD_YEARLY_ID=
# Legacy TEAM variables remain supported as fallbacks.
STRIPE_PRICE_TEAM_ID=
STRIPE_PRICE_TEAM_YEARLY_ID=

# Optional billing alarm delivery providers
# Email alarms are enabled only when both values are configured.
RESEND_API_KEY=
BILLING_ALERT_FROM_EMAIL=
# SMS alarms are enabled only when all three values are configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin (optional - comma-separated list of Supabase user IDs for admin access)
ADMIN_USER_IDS=

# Gaussian Splatting Training (Phase 5)
# SPLAT_TRAINING_WEBHOOK - URL of the training worker endpoint (e.g. Civo K8s job, external API)
# If unset, training jobs are created but not dispatched (dev mode).
SPLAT_TRAINING_WEBHOOK=
# SPLAT_CALLBACK_SECRET - shared secret for the training worker callback
SPLAT_CALLBACK_SECRET=


# Shared server-to-server billing contract for AI-PLAYGROUND and NPC-AI-SIM.
# Generate one random secret (32+ bytes) and store the same value as a server secret in all 3 services.
DREAMMAKERHUB_INTERNAL_BILLING_KEY=

# 3D/render credit packs. Quantity and Stripe price are both operator-configured.
RENDER_CREDIT_PACK_STARTER_UNITS=
STRIPE_RENDER_CREDIT_PACK_STARTER_PRICE_ID=
RENDER_CREDIT_PACK_BUILDER_UNITS=
STRIPE_RENDER_CREDIT_PACK_BUILDER_PRICE_ID=
RENDER_CREDIT_PACK_POWER_UNITS=
STRIPE_RENDER_CREDIT_PACK_POWER_PRICE_ID=

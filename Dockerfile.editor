FROM node:18-slim

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy application code
COPY . .

# Build Next.js app
RUN npm run build

# Expose ports
EXPOSE 3000 8080

# Create non-root user for security
RUN useradd -m appuser
USER appuser

# Start the application
CMD ["npm", "start"]